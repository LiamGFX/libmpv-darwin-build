From: SuperViewer <noreply@superviewer.invalid>
Subject: [PATCH] video/out: add avsbuf, an AVSampleBufferDisplayLayer VO (iOS/tvOS)

Shows frames on an app-supplied AVSampleBufferDisplayLayer (--vo=avsbuf
--wid=<layer pointer>), so video keeps playing in Picture in Picture and
in the background, where the OpenGL ES render API cannot run. See the
header of video/out/vo_avsbuf.m for the design. LGPL-2.1+.

diff --git a/meson.build b/meson.build
index 8c9e233..24b5e41 100644
--- a/meson.build
+++ b/meson.build
@@ -818,6 +818,20 @@ if features['audiounit']
     sources += files('audio/out/ao_audiounit.m')
 endif
 
+# SuperViewer: AVSampleBufferDisplayLayer video output. UIKit only exists on
+# iOS/tvOS, so this turns itself off for macOS builds.
+avsbuf_opt = get_option('avsbuf').require(darwin)
+avsbuf = dependency('appleframeworks',
+                    modules: ['Foundation', 'UIKit', 'QuartzCore', 'AVFoundation',
+                              'CoreMedia', 'CoreVideo'],
+                    required: avsbuf_opt)
+features += {'avsbuf': avsbuf.found()}
+if features['avsbuf']
+    add_languages('objc')
+    dependencies += avsbuf
+    sources += files('video/out/vo_avsbuf.m')
+endif
+
 avfoundation = dependency('appleframeworks', modules: ['CoreMedia', 'AVFoundation'],
                           required: get_option('avfoundation'))
 features += {'avfoundation': avfoundation.found()}
