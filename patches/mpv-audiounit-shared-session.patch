--- a/audio/out/ao_audiounit.m
+++ b/audio/out/ao_audiounit.m
@@ -24,6 +24,8 @@
 #include "ao_coreaudio_utils.h"
 #include "ao_coreaudio_chmap.h"
 
+#include <pthread.h>
