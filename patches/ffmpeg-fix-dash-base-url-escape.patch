dashdec: escape BaseURL text before xmlNodeSetContent

xmlNodeSetContent() parses entities, so a raw & in a BaseURL query string
is cut off. Inherited from the fork, ported to FFmpeg 8.0.3.
Drop when moving to FFmpeg 9.x (fixed upstream there).

diff --git a/libavformat/dashdec.c b/libavformat/dashdec.c
index e236ef6..17022e3 100644
--- a/libavformat/dashdec.c
+++ b/libavformat/dashdec.c
@@ -782,7 +782,15 @@ static int resolve_content_path(AVFormatContext *s, const char *url, int *max_ur
     }
     root_url = (av_strcasecmp(baseurl, "")) ? baseurl : path;
     if (node) {
-        xmlNodeSetContent(node, root_url);
+        // xmlNodeSetContent() parses entities, so a raw '&' in a URL query
+        // would be cut off; escape it first.
+        xmlChar *escaped = xmlEncodeSpecialChars(NULL, root_url);
+        if (!escaped) {
+            updated = AVERROR(ENOMEM);
+            goto end;
+        }
+        xmlNodeSetContent(node, escaped);
+        xmlFree(escaped);
         updated = 1;
     }
 
@@ -816,7 +824,14 @@ static int resolve_content_path(AVFormatContext *s, const char *url, int *max_ur
                 memset(p + 1, 0, strlen(p));
             }
             av_strlcat(tmp_str, text + start, tmp_max_url_size);
-            xmlNodeSetContent(baseurl_nodes[i], tmp_str);
+            xmlChar *escaped = xmlEncodeSpecialChars(NULL, tmp_str);
+            if (!escaped) {
+                xmlFree(text);
+                updated = AVERROR(ENOMEM);
+                goto end;
+            }
+            xmlNodeSetContent(baseurl_nodes[i], escaped);
+            xmlFree(escaped);
             updated = 1;
             xmlFree(text);
         }
